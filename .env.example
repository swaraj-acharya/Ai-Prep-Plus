# ─── Sign-in (required in production) ─────────────────────────────────────
# Your ID and password for the whole site. Without them a production deploy stays locked;
# local `npm run dev` is open so you can try the app immediately.
AUTH_ID=
AUTH_PASSWORD=
# Optional: a long random string to sign cookies. Changing it (or AUTH_PASSWORD) signs out every device.
AUTH_SECRET=

# ─── Save progress to GitHub (optional) ───────────────────────────────────
# Fine-grained token: https://github.com/settings/personal-access-tokens/new
#   Repository access → Only select repositories → your repo; Permissions → Contents: Read and write.
GITHUB_TOKEN=
# owner/repo — this app's own repo works; progress goes into PROGRESS_DIR only.
GITHUB_REPO=
# A long password you make up. Each device connects once with it (Settings → Save progress to GitHub).
# Leave empty to allow any signed-in device to push without it.
SYNC_SECRET=
# Optional: defaults to the repo's default branch / "progress".
GITHUB_BRANCH=
PROGRESS_DIR=progress
